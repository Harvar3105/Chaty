@inherits LayoutComponentBase

<div id="page" class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        @* TODO: display users UserName and Email in case if logged in. Maybe implement account management *@
        <div class="top-row px-4 text-color">
            <AuthorizeView>
                <Authorized>
                    <text> Welcome @context.User.Identity?.Name</text>
                    <NavLink class="nav-link text-color" href="account/friends">
                        Friends
                    </NavLink>
                    @* //TODO: fix button color  *@
                    <NavLink class="nav-link text-color" href="account/logout">
                        Logout
                    </NavLink>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="nav-link text-color" href="account/login">
                        Login
                    </NavLink>
                    <NavLink class="nav-link text-color" href="account/register">
                        Register
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
            <a class="text-color" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

