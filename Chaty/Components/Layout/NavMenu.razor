@using System.Security.Claims
@using Base.Contracts.Services
@using DAL.Domain
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<NavMenu> Logger
@inject IChatService<Chat> ChatService
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Chaty</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Users
            </NavLink>
        </div>
        
        @* TODO: Fix not updating after new one creation *@
        @if (_usersChats is not null)
        {
            foreach (var chat in _usersChats)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@($"chat/{chat.Id}")">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> @chat.ChatName
                    </NavLink>
                </div>
            }
        }
    </nav>
    <div>
        <button @onclick="ToggleTheme">Toggle Theme</button>
    </div>
    @* TODO: Create list of users chats *@
</div>

@code
{
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private List<Chat>? _usersChats;
    
    private async void ToggleTheme()
    {
        await Theme.ToggleThemeAsync();
    }

    private async Task GetUsersChats()
    {
        _usersChats = await ChatService.GetByUserIdAsync(await GetId());
    }
    
    private async Task<string> GetId()
    {
        var user = (await AuthenticationState!).User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        if (string.IsNullOrEmpty(userId))
        {
            Logger.LogWarning($"Cannot find current users id! Identity: {user.Identity!.Name}, {user.Identity.IsAuthenticated}" );
            throw new Exception($"Cannot find current users id! Identity: {user.Identity!.Name}, {user.Identity.IsAuthenticated}" );
        }

        return userId;
    }
    
    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += LocationChanged;
        await GetUsersChats();
        await base.OnInitializedAsync();
    }
    
    async void LocationChanged(object sender, LocationChangedEventArgs e)
    {
        string navigationMethod = e.IsNavigationIntercepted ? "HTML" : "code";
        Logger.LogInformation($"Notified of navigation via {navigationMethod} to {e.Location} at " + DateTime.UtcNow);
        await Task.Delay(50); //TODO: Find way to detect siblings render finish
        await Theme.ForceUpdateTheme();
    }
    
    void IDisposable.Dispose()
    {
        NavigationManager.LocationChanged -= LocationChanged;
    }
}
