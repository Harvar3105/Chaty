@inject ILogger<FriendsSelect> Logger
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager

@* TODO: implement FuzzySearch and filter *@

@if (_usersList.Any()){
    <table id="friendstable" class="table" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
        <thead>
        <tr>
            @if (AuthenticationState!.Result.User.IsInRole("Admin"))
            {
            <th>ID</th>
            <th>Role</th>
            }
            <th>Username</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Age</th>
            <th>Email</th>
            <th>Interactions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in _usersList)
        {
        <tr>
            @if (AuthenticationState!.Result.User.IsInRole("Admin"))
            {
            <td>@user.Id.Trim()</td>
            <td>@string.Join(", ", user.Roles).Trim()</td>
            }
            <td>@user.UserName?.Trim()</td>
            <td>@user.FirstName?.Trim()</td>
            <td>@user.LastName?.Trim()</td>
            <td>@user.Age</td>
            <td>@user.Email?.Trim()</td>
            <td>
                @if (!SelectedFriends.Contains(user))
                {
                    <button type="button" class="btn btn-red" @onclick="() => ToggleSelect(user)">
                        <span class="bi bi-person-add" aria-hidden="true"></span>Add
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-green" @onclick="() => ToggleSelect(user)">
                        <span class="bi bi-person-remove" aria-hidden="true"></span>Remove
                    </button>
                }
            </td>
        </tr>
        }
        </tbody>
    </table>
}
else
{
<div class="alert alert-danger">Sorry, but here's no friends. Try find some at "Users" page!</div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }
    
    [Parameter] public List<User> SelectedFriends { get; set; } = new List<User>();
    [Parameter] public EventCallback<List<User>> SelectedFriendsChanged { get; set; }
    
    private List<User> _usersList = new();
    private readonly HashSet<string> _usersFriendships = [];

    private void ToggleSelect(User user)
    {
        if (SelectedFriends.Contains(user)) SelectedFriends.Remove(user);
        else SelectedFriends.Add(user);
        
        StateHasChanged();
    }
    
    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUsersId();

        var friendships = await FriendshipService.GetFriendshipsByUserIdAsync(userId);

        foreach (var friendship in friendships)
        {
            _usersFriendships.Add(friendship.FirstUserId);
            _usersFriendships.Add(friendship.SecondUserId);
        }

        _usersFriendships.Remove(userId);
        
        _usersList = UserManager.Users.Where(u => _usersFriendships.Contains(u.Id)).ToList();
        
        Logger.LogInformation($"For current user:{userId} found friends {string.Join(", ", _usersList.Select(u => u.UserName))}");
    }
    
    private async Task<string> GetCurrentUsersId()
    {
        var user = (await AuthenticationState!).User;
        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        if (string.IsNullOrEmpty(userId))
        {
            Logger.LogWarning($"Cannot find current users id! Identity: {user.Identity!.Name}, {user.Identity.IsAuthenticated}" );
            throw new Exception($"Cannot find current users id! Identity: {user.Identity!.Name}, {user.Identity.IsAuthenticated}" );
        }

        return userId;
    }
}