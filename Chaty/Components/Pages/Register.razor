@page "/Register"
@rendermode InteractiveServer
@using Chaty.Models
@using Chaty.Helpers.Services
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject HttpService UserService
@inject AuthenticationStateProvider Asp

<PageTitle>Register</PageTitle>

<h3>Register</h3>

@if (!string.IsNullOrWhiteSpace(_errMessage))
{
    <div class="alert alert-danger">@_errMessage</div>
}

<EditForm Model="@_registerModel" OnValidSubmit="HandleRegistration">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="_registerModel.Username" class="form-control" />
        <ValidationMessage For="@(() => _registerModel.Username)" />
    </div>
    
    <div>
        <label for="firstName">First Name (Optional)</label>
        <InputText id="firstName" @bind-Value="_registerModel.FirstName" class="form-control" />
    </div>

    <div>
        <label for="lastName">Last Name (Optional)</label>
        <InputText id="lastName" @bind-Value="_registerModel.LastName" class="form-control" />
    </div>

    <div>
        <label for="age">Age</label>
        <InputNumber id="age" @bind-Value="_registerModel.Age" class="form-control" />
        <ValidationMessage For="@(() => _registerModel.Age)" />
    </div>

    <div>
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="_registerModel.Email" class="form-control" />
        <ValidationMessage For="@(() => _registerModel.Email)" />
    </div>
    
    <div>
        <label for="password">Password</label>
        <InputText id="password" @bind-Value="_registerModel.Password" class="form-control" />
        <ValidationMessage For="@(() => _registerModel.Password)"></ValidationMessage>
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@code {
    private readonly RegisterModel _registerModel = new RegisterModel();
    private string? _errMessage;

    private async Task HandleRegistration()
    {
        try
        {
            await UserService.RegisterAsync(_registerModel);
            Console.WriteLine("Registration successful!");
            Console.WriteLine(_registerModel.Username);
            Console.WriteLine(_registerModel.FirstName);
            Console.WriteLine(_registerModel.LastName);
            Console.WriteLine(_registerModel.Age);
            Console.WriteLine(_registerModel.Email);
            Console.WriteLine(_registerModel.Password);
            
            Navigation.NavigateTo("/");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            // _errMessage = e.Message;
            Match match = Regex.Match(e.Message, @"ERROR:\s*(\d+)");
            if (match.Success)
            {
                _errMessage = e.Message.Replace(match.ToString(), "")
                    .Replace("\"", "")
                    .Replace("{", "")
                    .Replace("}", "")
                    .Replace("message", "")
                    .Replace(":. ", "");
            }
            else
            {
                Console.WriteLine("Unknown error! " + e.Message);
            }
        }
    }
}