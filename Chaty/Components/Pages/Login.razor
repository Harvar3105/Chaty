@page "/Login"
@using Chaty.Models
@using Chaty.Services
@using Helpers
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpService UserService

<PageTitle>Login</PageTitle>

<h3>Login</h3>

@if (!string.IsNullOrWhiteSpace(_errMessage))
{
<div class="alert alert-danger">@_errMessage</div>
}

<EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    
    <div>
        <label for="login">Login</label>
        <InputText id="login" @bind-Value="_loginModel.Login" class="form-control"/>
        <ValidationMessage For="@(() => _loginModel.Login )"/>
    </div>
    <div>
        <label for="password">Password</label>
        <InputText id="password" @bind-Value="_loginModel.Password" class="form-control"/>
        <ValidationMessage For="@(() => _loginModel.Password )"/>
    </div>
    
    <br/>
    <button type="submit" class="btn btn-primary">Log in</button>
</EditForm>

@code {
    private readonly LoginModel _loginModel = new LoginModel();
    private string? _errMessage;

    private async Task HandleLogin()
    {
        try
        {
            await UserService.LoginAsync(_loginModel);
            Navigation.NavigateTo("/");
        }
        catch (Exception e)
        {
            _errMessage = e.Message;
        }
    }
}